{
  "name": "office363",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "version:set": "node scripts/version.mjs",
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version": "node scripts/version.mjs",
    "test:release": "node --test scripts/tests/*.test.mjs && python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
